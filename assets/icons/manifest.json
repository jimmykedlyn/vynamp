{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schema_version": 1,
  "name": "Vynamp Audio File Icon Packs",
  "version": "0.8.0",
  "brand": {
    "concept": "C",
    "concept_name": "Pulso",
    "colors": {
      "accent": "#FFBF69",
      "background": "#11131B",
      "wordmark_light": "#F0F2F5",
      "wordmark_dark": "#11131B"
    }
  },
  "tools": [
    {
      "id": "vynamp",
      "name": "Vynamp Media Player",
      "description": "Reprodutor de áudio principal de alta fidelidade",
      "executable": "vynamp",
      "icon": "vynamp-symbol-c.svg"
    },
    {
      "id": "vynamp-restore",
      "name": "Vynamp Restore",
      "description": "Ferramenta desktop dedicada de análise e restauração acústica",
      "executable": "vynamp-restore",
      "icon": "tools/vynamp-restore.svg",
      "badge_color": "#66D9EF"
    },
    {
      "id": "vynamp-converter",
      "name": "Vynamp Converter",
      "description": "Ferramenta desktop dedicada de transcodificação e conversão em lote",
      "executable": "vynamp-converter",
      "icon": "tools/vynamp-converter.svg",
      "badge_color": "#B8F35A"
    }
  ],
  "families": [
    {
      "id": "document",
      "name": "Documento",
      "description": "Arquivo com dobra superior direita, etiqueta tipográfica e glifo musical",
      "glyph_source": "file-audio (MVP rev.38)",
      "target_users": "Organização clássica de pastas e listagem densa"
    },
    {
      "id": "disc",
      "name": "Disco",
      "description": "Vinil estilizado com ranhuras concêntricas escuras e rótulo central colorido",
      "glyph_source": "vinyl (MVP rev.38)",
      "target_users": "Entusiastas do conceito analógico e identidade Vynamp"
    },
    {
      "id": "signal",
      "name": "Sinal",
      "description": "Chassis técnico com barras de forma de onda espectral e rotulagem de estúdio",
      "glyph_source": "waveform (MVP rev.38)",
      "target_users": "Perfis de produção, análise e masterização acústica"
    }
  ],
  "resolutions": [16, 24, 32, 48, 64, 128, 256],
  "formats": [
    {
      "id": "flac",
      "label": "FLAC",
      "category": "lossless",
      "extensions": [".flac"],
      "mime": "audio/flac",
      "color": "#FFBF69",
      "description": "Free Lossless Audio Codec (IETF 64/64)"
    },
    {
      "id": "wav",
      "label": "WAV",
