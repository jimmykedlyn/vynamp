{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://spec.vynamp.invalid/plugin-manifest.schema.json",
  "title": "plugin-manifest",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "sdk_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "provider",
        "metadata",
        "utility",
        "visualizer",
        "decoder"
      ]
    },
    "runtime": {
      "enum": [
        "wasm",
        "native-helper"
      ]
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "supported_platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "windows-x86_64",
          "windows-aarch64",
          "linux-x86_64",
          "linux-aarch64",
          "macos-x86_64",
          "macos-aarch64",
          "portable-wasm",
          "android-arm64-v8a",
          "android-x86_64"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "enum": [
              "network.domains",
              "files.read.selected_roots",
              "files.write.selected_output",
              "library.read",
              "library.modify",
              "playback.control",
              "metadata.read",
              "system.notifications"
            ]
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "capability",
          "purpose"
        ],
        "additionalProperties": false
      }
    },
    "resource_limits": {
      "type": "object",
      "properties": {
        "memory_mib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "compute_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "max_concurrent_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "memory_mib",
        "compute_timeout_ms",
        "max_concurrent_calls"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "sdk_version",
    "name",
    "author",
    "license",
    "kind",
    "runtime",
    "entrypoint",
    "supported_platforms",
    "permissions",
    "resource_limits",
    "files"
  ],
  "additionalProperties": false
}
