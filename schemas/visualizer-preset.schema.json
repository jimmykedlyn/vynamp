{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "family": {
      "enum": [
        "spectrum",
        "waveform",
        "meters",
        "spectrogram",
        "phase",
        "particles"
      ]
    },
    "tap": {
      "enum": [
        "source",
        "pre-eq",
        "post-eq",
        "final"
      ]
    },
    "channel": {
      "enum": [
        "mix",
        "left",
        "right",
        "stereo"
      ]
    },
    "fft_size": {
      "enum": [
        2048,
        4096
      ]
    },
    "window": {
      "const": "hann"
    },
    "motion": {
      "enum": [
        "off",
        "reduced",
        "full"
      ]
    },
    "fps": {
      "enum": [
        10,
        30,
        60
      ]
    },
    "palette": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "parameters": {
      "type": "object",
      "properties": {
        "smoothing_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "hold_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000
        },
        "floor_dbfs": {
          "type": "number",
          "minimum": -144,
          "maximum": -20
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "name",
    "family",
    "tap",
    "channel",
    "fft_size",
    "window",
    "motion",
    "fps",
    "palette",
    "parameters"
  ]
}
